-- ==================== PASTAS E GERENCIAMENTO ====================
local folderCubes = workspace:FindFirstChild("AuraCubesFolder") or Instance.new("Folder")
folderCubes.Name = "AuraCubesFolder"
folderCubes.Parent = workspace

local function updateCubeVisual(cube, index, total)
   for _, child in ipairs(cube:GetChildren()) do if child:IsA("Fire") or child:IsA("Sparkles") then child:Destroy() end end
   if config.VisualMode == "RGB" then
      cube.Material = Enum.Material.Neon cube.Color = Color3.fromHSV(index / total, 1, 1) cube.Transparency = 0
   elseif config.VisualMode == "Fogo" then
      cube.Material = Enum.Material.Neon cube.Color = Color3.fromRGB(255, 100, 0) cube.Transparency = 0.05
      local f = Instance.new("Fire") f.Size = 4 f.Heat = 9 f.Parent = cube
   elseif config.VisualMode == "Gelo" then
      cube.Material = Enum.Material.Glass cube.Color = Color3.fromRGB(0, 191, 255) cube.Transparency = 0.3
      local s = Instance.new("Sparkles") s.Parent = cube
   elseif config.VisualMode == "Normal" then
      cube.Material = Enum.Material.SmoothPlastic cube.Color = Color3.fromRGB(160, 160, 160) cube.Transparency = 0
   end
end

local function recreateCubes(count)
   folderCubes:ClearAllChildren()
   if not config.Enabled then return end
   for i = 1, count do
      local part = Instance.new("Part")
      part.Name = "AuraCubePart"
      part.Size = Vector3.new(1.5, 1.5, 1.5) 
      part.Anchored = false 
      part.CanCollide = false
      part.CustomPhysicalProperties = PhysicalProperties.new(100, 0, 0, 100, 100)
      local bv = Instance.new("BodyVelocity")
      bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
      bv.Velocity = Vector3.new(0, 0, 0)
      bv.Parent = part
      updateCubeVisual(part, i, count)
      part.Parent = folderCubes
   end
end
recreateCubes(config.Count)

-- Gerador de Clones para a Aura do Mapa
local customAuraFolder = nil
local function rebuildCustomAura()
   if workspace:FindFirstChild("CustomMapAuraFolder") then
      workspace.CustomMapAuraFolder:Destroy()
   end
   if not config.CustomAuraEnabled or not config.SelectedTargetPart then return end

   customAuraFolder = Instance.new("Folder")
   customAuraFolder.Name = "CustomMapAuraFolder"
   customAuraFolder.Parent = workspace

   for i = 1, config.CustomCount do
      local clone = config.SelectedTargetPart:Clone()
      clone.Name = "CustomAuraObj_" .. i
      clone.Anchored = true
      clone.CanCollide = false
      clone.Parent = customAuraFolder
   end
end


-- ==================== CONSTRUÇÃO DA ASA GIGANTE DETALHADA ====================
local function buildEpicWings()
   if workspace:FindFirstChild("EpicWingsFolder") then
      workspace.EpicWingsFolder:Destroy()
   end

   local folder = Instance.new("Folder")
   folder.Name = "EpicWingsFolder"
   folder.Parent = workspace

   local function createSide(isLeft)
      local sideFolder = Instance.new("Folder")
      sideFolder.Name = isLeft and "LeftWing" or "RightWing"
      sideFolder.Parent = folder

      for i = 1, 14 do
         local part = Instance.new("Part")
         part.Name = "Feather_" .. i
         local scaleFactor = 1 + (i * 0.1)
         part.Size = Vector3.new(0.6, 1.8 * scaleFactor, 0.6)
         part.Anchored = true
         part.CanCollide = false
         part.Material = Enum.Material.Neon
         part.Parent = sideFolder
      end
   end

   createSide(true)
   createSide(false)

   return folder
end

local epicWingsFolder = buildEpicWings()

local function updateEpicWingsVisual()
   if not epicWingsFolder or not epicWingsFolder.Parent then return end
   for _, side in ipairs(epicWingsFolder:GetChildren()) do
      for _, cube in ipairs(side:GetChildren()) do
         if cube:IsA("Part") then
            for _, child in ipairs(cube:GetChildren()) do
               if child:IsA("Fire") or child:IsA("Sparkles") then child:Destroy() end
            end

            if config.WingVisual == "Fogo" then
               cube.Material = Enum.Material.Neon
               cube.Color = Color3.fromRGB(230, 20, 20)
               local f = Instance.new("Fire")
               f.Size = 4
               f.Heat = 12
               f.Color = Color3.fromRGB(255, 60, 0)
               f.Parent = cube
            elseif config.WingVisual == "RGB" then
               cube.Material = Enum.Material.Neon
               cube.Color = Color3.fromHSV((tick() * 0.2 + cube.Position.Y * 0.1) % 1, 1, 1)
            elseif config.WingVisual == "Gelo" then
               cube.Material = Enum.Material.Glass
               cube.Color = Color3.fromRGB(0, 200, 255)
               local s = Instance.new("Sparkles")
               s.Parent = cube
            else
               cube.Material = Enum.Material.Neon
               cube.Color = Color3.fromRGB(180, 20, 40)
            end
         end
      end
   end
end


