-- ==================== LOOP PRINCIPAL DE ANIMAÇÃO ====================
local tickTime = 0
local lastVisualMode = config.VisualMode

RunService.RenderStepped:Connect(function(dt)
   local character = player.Character
   if not character or not character:FindFirstChild("HumanoidRootPart") then return end
   local rootPart = character.HumanoidRootPart

   if bluePart and bluePart.Parent then
      bluePart.Size = Vector3.new(config.SphereSize, config.SphereSize, config.SphereSize)
      redPart.Size = Vector3.new(config.SphereSize, config.SphereSize, config.SphereSize)
      purplePart.Size = Vector3.new(config.SphereSize * 1.8, config.SphereSize * 1.8, config.SphereSize * 1.8)
   end

   -- Atualização da Aura de Cubos
   if config.Enabled then
      tickTime = tickTime + (dt * config.Speed)
      local currentCubes = folderCubes:GetChildren()
      if #currentCubes ~= config.Count or lastVisualMode ~= config.VisualMode then
         lastVisualMode = config.VisualMode
         recreateCubes(config.Count)
         currentCubes = folderCubes:GetChildren()
      end
      
      local total = #currentCubes
      for i, cube in ipairs(currentCubes) do
         if cube and cube:IsA("Part") then
            if config.VisualMode == "RGB" then cube.Color = Color3.fromHSV((i / total + tickTime * 0.1) % 1, 1, 1) end
            local angle = (i / total) * (math.pi * 2) + tickTime
            
            local targetPos = Vector3.new(0,0,0)
            if config.AnimationMode == "Circle" then
               local x = math.cos(angle) * config.Distance local z = math.sin(angle) * config.Distance
               targetPos = rootPart.Position + Vector3.new(x, config.Height, z)
            elseif config.AnimationMode == "Inverted" then
               local x = math.cos(angle) * config.Distance local z = math.sin(angle) * config.Distance
               targetPos = rootPart.Position + Vector3.new(x, -config.Height, z)
            elseif config.AnimationMode == "Random" then
               local rx = math.sin(tickTime + i) * config.Distance local ry = math.cos(tickTime * 1.3 + i) * config.Distance + config.Height local rz = math.sin(tickTime * 0.7 + i) * config.Distance
               targetPos = rootPart.Position + Vector3.new(rx, ry, rz)
            end

            local bv = cube:FindFirstChildOfClass("BodyVelocity")
            if bv then bv.Velocity = (targetPos - cube.Position) * 25 end
            cube.CFrame = CFrame.new(targetPos) * CFrame.Angles(tickTime, tickTime, 0)

            if config.FlingEnabled then
               for _, p in ipairs(Players:GetPlayers()) do
                  if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                     local pRoot = p.Character.HumanoidRootPart
                     if (cube.Position - pRoot.Position).Magnitude < 3.5 then
                        pRoot.Velocity = Vector3.new(math.random(-500, 500), 9999, math.random(-500, 500))
                        pRoot.RotVelocity = Vector3.new(math.random(-5000, 5000), math.random(-5000, 5000), math.random(-5000, 5000))
                     end
                  end
               end
            end
         end
      end
   end

   -- Atualização da Aura do Objeto do Mapa
   if config.CustomAuraEnabled and config.SelectedTargetPart then
      if not customAuraFolder or not customAuraFolder.Parent or #customAuraFolder:GetChildren() ~= config.CustomCount then
         rebuildCustomAura()
      end
      if customAuraFolder then
         local customTime = tick() * config.CustomSpeed
         local objChildren = customAuraFolder:GetChildren()
         local totalObj = #objChildren
         for i, obj in ipairs(objChildren) do
            if obj and obj:IsA("Part") then
               local angle = (i / totalObj) * (math.pi * 2) + customTime
               local x = math.cos(angle) * config.CustomDistance
               local z = math.sin(angle) * config.CustomDistance
               local targetPos = rootPart.Position + Vector3.new(x, config.CustomHeight, z)
               obj.CFrame = CFrame.new(targetPos) * CFrame.Angles(customTime, customTime, 0)
            end
         end
      end
   else
      if customAuraFolder and customAuraFolder.Parent then customAuraFolder:Destroy() end
   end

   -- Atualização das Asas Gigantes
   if config.WingEnabled then
      if not epicWingsFolder or not epicWingsFolder.Parent then
         epicWingsFolder = buildEpicWings()
      end
      updateEpicWingsVisual()

      local wingTick = tick() * config.WingSpeed
      local flap = math.sin(wingTick) * 0.45
      local baseCF = rootPart.CFrame * CFrame.new(0, config.WingHeight, config.WingDepth)

      local leftWing = epicWingsFolder:FindFirstChild("LeftWing")
      local rightWing = epicWingsFolder:FindFirstChild("RightWing")

      if leftWing then
         for i, cube in ipairs(leftWing:GetChildren()) do
            if cube:IsA("Part") then
               local t = i / 14
               local offsetX = -0.6 - (t * 2.8)
               local offsetY = math.sin(t * math.pi * 0.8) * 2.2 + (t * 0.8)
               local offsetZ = math.cos(t * math.pi * 0.5) * 0.5
               local rot = CFrame.Angles(0.2, 0.5, -0.6 - (t * 0.4) - flap)
               cube.CFrame = baseCF * CFrame.new(offsetX, offsetY, offsetZ) * rot
            end
         end
      end

      if rightWing then
         for i, cube in ipairs(rightWing:GetChildren()) do
            if cube:IsA("Part") then
               local t = i / 14
               local offsetX = 0.6 + (t * 2.8)
               local offsetY = math.sin(t * math.pi * 0.8) * 2.2 + (t * 0.8)
               local offsetZ = math.cos(t * math.pi * 0.5) * 0.5
               local rot = CFrame.Angles(0.2, -0.5, 0.6 + (t * 0.4) + flap)
               cube.CFrame = baseCF * CFrame.new(offsetX, offsetY, offsetZ) * rot
            end
         end
      end
   else
      if epicWingsFolder and epicWingsFolder.Parent then epicWingsFolder:Destroy() end
   end

   -- Atualização das Técnicas do Gojo
   if config.GojoEnabled then
      if not gojoFolder or not gojoFolder.Parent then
         gojoFolder, bluePart, redPart, purplePart = buildGojoTechnique()
      end

      local timeCycle = (tick() * config.OrbitSpeed) % 8

      if timeCycle < 4.5 then
         purplePart.Transparency = 1
         bluePart.Transparency = 0
         redPart.Transparency = 0

         local angleBlue = timeCycle * 2.5
         local angleRed = angleBlue + math.pi

         local bx = math.cos(angleBlue) * config.OrbitDistance
         local bz = math.sin(angleBlue) * config.OrbitDistance
         bluePart.CFrame = CFrame.new(rootPart.Position + Vector3.new(bx, 3, bz))

         local rx = math.cos(angleRed) * config.OrbitDistance
         local rz = math.sin(angleRed) * config.OrbitDistance
         redPart.CFrame = CFrame.new(rootPart.Position + Vector3.new(rx, 3, rz))

      elseif timeCycle >= 4.5 and timeCycle < 7.2 then
         bluePart.Transparency = 1
         redPart.Transparency = 1
         purplePart.Transparency = 0

         local progress = (timeCycle - 4.5) / 2.7 
         local currentHeight = progress * config.MaxHeight

         purplePart.CFrame = CFrame.new(rootPart.Position + Vector3.new(0, currentHeight, 0))

         local shakeIntensity = 0.9
         Camera.CFrame = Camera.CFrame * CFrame.new(
            math.random(-100, 100) * 0.01 * shakeIntensity,
            math.random(-100, 100) * 0.01 * shakeIntensity,
            math.random(-100, 100) * 0.01 * shakeIntensity
         )
      else
         purplePart.Transparency = 1
      end
   else
      if gojoFolder and gojoFolder.Parent then gojoFolder:Destroy() end
   end
end)

